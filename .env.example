WILDLIFE_MLOPS_ENVIRONMENT=local
WILDLIFE_MLOPS_API_ENDPOINT=http://127.0.0.1:8000
WILDLIFE_MLOPS_API_TOKEN=replace-with-a-local-test-token

# Local MLflow Compose stack. Use unique, URL-safe values in your .env file.
POSTGRES_DB=mlflow
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=replace-with-a-local-postgres-password
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace-with-a-local-minio-password
MLFLOW_S3_BUCKET=mlflow-artifacts
MLFLOW_HOST_PORT=5001
